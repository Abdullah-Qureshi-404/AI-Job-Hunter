# ApplyAI backend environment variables.
# Copy to .env and fill in real values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Enables offline JWT verification. Without it every request costs a ~515ms
# round-trip to Supabase. Dashboard -> Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=applyai-resumes

# --- Voyage AI (embeddings) ---
VOYAGE_API_KEY=

# --- Groq (LLM) ---
GROQ_API_KEY=

# --- CORS ---
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
